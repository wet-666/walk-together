# 2G 机用：本机先 pnpm build:api，镜像里只装生产依赖，避免在服务器上编译 Nest。
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
RUN NODE_OPTIONS=--max-old-space-size=384 pnpm install --frozen-lockfile --prod --filter @walk-together/api...
COPY apps/api/dist apps/api/dist
COPY packages/shared-types/dist packages/shared-types/dist
RUN mkdir -p /app/apps/api/uploads/avatars /app/apps/api/uploads/chat /app/apps/api/uploads/covers
WORKDIR /app/apps/api
ENV NODE_OPTIONS=--max-old-space-size=192
EXPOSE 3000
CMD ["node", "dist/main.js"]
