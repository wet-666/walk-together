# 复制为 apps/api/.env 后按本地修改。不要把真实密钥提交进仓库。

NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0-m0

# 开发可留 *。上线改成 H5 域名，逗号分隔。小程序不受 CORS 限制。
CORS_ORIGIN=*

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=walk
MYSQL_PASSWORD=walktogether
MYSQL_DATABASE=walk_together

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=replace-me-in-m1

# M1 起使用，M0 只占槽位
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=

# M2 / M3 起使用
AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_ANDROID_KEY=
AMAP_IOS_KEY=

# M4 起使用
IM_SDK_APP_ID=
IM_SECRET_KEY=

# M5 起使用
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
