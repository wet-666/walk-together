# 复制为 apps/api/.env 后按本机改。别把真实密钥提交进仓库。

NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0-m6

# 开发可留 *。上线改成 H5 域名，逗号分隔。
CORS_ORIGIN=*

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=walk
MYSQL_PASSWORD=walktogether
MYSQL_DATABASE=walk_together

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=walk-together-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# 非 production 且不为 false 时，验证码固定为 SMS_DEV_CODE。
AUTH_DEV_MODE=true
SMS_DEV_CODE=123456

# 真发短信才需要。不填就走上面的开发验证码。
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_PROVIDER=aliyun
SMS_SDK_APP_ID=
SMS_REGION=

# 地理编码、逆地理、驾车路线。不填也能发布，地图上就只有地名。
AMAP_WEB_KEY=
