# 复制为 apps/api/.env 后按本地修改。不要把真实密钥提交进仓库。

NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0-m4

# 开发可留 *。上线改成 H5 域名，逗号分隔。小程序不受 CORS 限制。
CORS_ORIGIN=*

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=walk
MYSQL_PASSWORD=walktogether
MYSQL_DATABASE=walk_together

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=walk-together-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# 非 production 且不为 false 时：短信固定码、允许微信 code 以 dev: 开头
AUTH_DEV_MODE=true
SMS_DEV_CODE=123456

# 正式微信 / 短信密钥。没配时走上面的开发登录。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# aliyun（默认）或 tencent。腾讯云还要填 SMS_SDK_APP_ID。
SMS_PROVIDER=aliyun
SMS_SDK_APP_ID=
SMS_REGION=

# M2 / M3 起使用。Web Key 给后端地理编码和路线；JS Key 给 H5 底图。
AMAP_WEB_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY=
AMAP_ANDROID_KEY=
AMAP_IOS_KEY=

# M4 起使用。没填时群聊走自己的接口和 WebSocket，H5 照样能验。
# 填了之后才会签发 UserSig，并在入队/退队时同步腾讯云 IM 群。
IM_SDK_APP_ID=
IM_SECRET_KEY=
IM_ADMIN_USER=administrator

# M5 起使用
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
